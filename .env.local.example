# Copy to .env.local and fill in. All values are optional — without them the
# app runs in "not_configured" mode and explains what to add.

# Spotify: https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# YouTube Data API v3: https://console.cloud.google.com/apis/credentials
YOUTUBE_API_KEY=

# Tunables (optional)
# TUNESHIFT_CACHE_TTL_SECONDS=300
# TUNESHIFT_RATE_LIMIT_PER_MINUTE=60
