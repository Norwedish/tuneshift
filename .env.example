# ---- TuneShift environment ------------------------------------------------
# Copy to .env.local and fill in. Secrets never reach the browser.

# Spotify Web API — https://developer.spotify.com/dashboard
# Client Credentials flow is enough for search + public metadata.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Optional: only needed if you later enable "save to my library".
# SPOTIFY_REDIRECT_URI=http://localhost:3000/api/auth/spotify/callback

# YouTube Data API v3 — https://console.cloud.google.com/apis/credentials
# Enable "YouTube Data API v3" on the project first.
YOUTUBE_API_KEY=

# Optional tuning
# TUNESHIFT_CACHE_TTL_SECONDS=300
# TUNESHIFT_RATE_LIMIT_PER_MINUTE=60
